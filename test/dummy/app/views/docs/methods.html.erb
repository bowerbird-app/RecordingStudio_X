<% dummy_page_nav(title: "Methods", subtitle: "Read posts, people, and identity through RecordingStudio::X.", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::SectionTitle::Component.new(
    title: "Search",
    subtitle: "RecordingStudio::X.search",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      page = RecordingStudio::X.search("from:XDevelopers")
      page.posts.each { |post| puts post.text }
    CODE
  ) %>

  <p class="text-sm text-(--body-muted-content-color)">
    Search, post, user, user_posts, and identity are the read methods.
  </p>
</div>
