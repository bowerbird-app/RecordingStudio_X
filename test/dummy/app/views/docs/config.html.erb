<% dummy_page_nav(title: "Config", subtitle: "Bearer, OAuth 1, and OAuth 2 client settings for X.", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudio::X.configure do |config|
        config.bearer_token = ENV["x_bearer_token"]
        config.client_id = ENV["x_client_id"]
        config.client_secret = ENV["x_client_secret"]
      end
    CODE
  ) %>
</div>
