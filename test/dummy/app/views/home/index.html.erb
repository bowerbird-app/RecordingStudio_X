<% dummy_page_nav(title: "Search X", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Search X",
    subtitle: "Recent posts from the last 7 days.",
    variant: :h1
  ) %>

  <%= form_with url: root_path, method: :get do %>
    <div class="flex w-full flex-col gap-4">
      <%= render FlatPack::SearchInput::Component.new(
        name: "q",
        value: @query,
        label: "Search",
        placeholder: "BowerBird"
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Search",
        style: :primary,
        type: "submit",
        name: ""
      ) %>
    </div>
  <% end %>

  <% if @error.present? %>
    <%= render FlatPack::Alert::Component.new(description: @error, style: :danger) %>
  <% elsif @page %>
    <% if @page.items.empty? %>
      <%= render FlatPack::EmptyState::Component.new(
        title: "No posts matched",
        description: "Try another phrase."
      ) %>
    <% else %>
      <div class="flex w-full flex-col gap-4">
        <% @page.items.each do |post| %>
          <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
            <% card.body do %>
              <div class="flex flex-col gap-2">
                <p class="text-sm font-medium">
                  <%= post.author&.name %>
                  <% if post.author&.username.present? %>
                    <span class="text-(--surface-muted-content-color)">@<%= post.author.username %></span>
                  <% end %>
                </p>
                <p class="text-sm leading-6"><%= post.text %></p>
                <p class="text-xs text-(--surface-muted-content-color)">
                  <%= post.created_at&.strftime("%-d %b %Y") %>
                  <% if post.metrics["like_count"] %>
                    · <%= post.metrics["like_count"] %> likes
                  <% end %>
                </p>
                <% if post.url.present? %>
                  <%= render FlatPack::Link::Component.new(href: post.url, target: "_blank") do %>
                    View on X
                  <% end %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <% if @page.more? %>
        <%= render FlatPack::Button::Component.new(
          text: "More posts",
          style: :secondary,
          href: root_path(q: @query, cursor: @page.next_cursor)
        ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
